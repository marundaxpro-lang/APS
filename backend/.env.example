# Supabase Configuration (Required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email Configuration
# Optional: customize the from address for transactional emails
# Default: APS App <noreply@aps.app>
FROM_EMAIL=

# OAuth Providers (Optional)
# Set these to enable Google or Apple OAuth sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
